@using SanaNoor_Brand.Models.ViewModel
@model RegisterViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #ffffff, #f3e8ff, #e0b3ff);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .register-box {
            width: 1000px;
            max-width: 95%;
            display: flex;
            border-radius: 15px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 8px 30px rgba(155, 0, 255, 0.3);
        }

        /* LEFT SIDE */
        .register-left {
            flex: 1;
            background: url('@Url.Content("~/Website/assets/images/logo2.png")') no-repeat center;
            background-size: cover;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .register-left::after {
                content: "";
                position: absolute;
                width: 100%;
                height: 100%;
                background: rgba(90, 0, 255, 0.5);
            }

            .register-left h1 {
                color: #fff;
                z-index: 2;
                font-size: 40px;
                font-weight: bold;
            }

        /* RIGHT SIDE */
        .register-right {
            flex: 1;
            padding: 50px;
        }

            .register-right h2 {
                color: #5a00ff;
                font-weight: bold;
                margin-bottom: 25px;
            }

        .form-control {
            border-radius: 8px;
            padding: 12px;
        }

        .btn-register {
            background: linear-gradient(90deg, #9b00ff, #5a00ff);
            border: none;
            border-radius: 25px;
            padding: 12px;
            color: #fff;
            font-weight: bold;
            width: 100%;
            margin-top: 15px;
        }

        .login-link {
            text-align: center;
            margin-top: 20px;
        }

            .login-link a {
                color: #5a00ff;
                font-weight: 600;
                text-decoration: none;
            }

        @@media(max-width:768px) {
            .register-box {
                flex-direction: column;
            }

            .register-left {
                height: 250px;
            }

            .register-right {
                padding: 30px;
            }
        }
    </style>
</head>

<body>

    <div class="register-box">

        <!-- LEFT -->
        <div class="register-left">
            <h1>JOIN US!</h1>
        </div>

        <!-- RIGHT -->
        <div class="register-right">

            <h2>Create Account ✨</h2>

            <form asp-action="Register" asp-controller="Auth" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <!-- First + Last -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="First Name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Last Name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm Password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <!-- Register -->
                <button type="submit" class="btn btn-register">
                    Register
                </button>

            </form>

            <!-- Login -->
            <div class="login-link">
                Already have an account?
                <a asp-controller="Auth" asp-action="Login">
                    Login
                </a>
            </div>

        </div>

    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>