@model List<SanaNoor_Brand.Models.Wishlist>
@{
    ViewData["Title"] = "Wishlist";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<main class="main">
    <div class="page-header text-center" style="background-image: url('~/Website/assets/images/page-header-bg.jpg')">
        <div class="container">
            <h1 class="page-title">Favourites<span>Shop</span></h1>
        </div><!-- End .container -->
    </div><!-- End .page-header -->
    <nav aria-label="breadcrumb" class="breadcrumb-nav">
        <div class="container">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Allproduct", "Home")">Shop</a></li>
                <li class="breadcrumb-item active" aria-current="page">Wishlist</li>
            </ol>
        </div><!-- End .container -->
    </nav><!-- End .breadcrumb-nav -->

    <div class="page-content">
        <div class="container">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="icon-heart-o" style="font-size:60px; color:#ddd;"></i>
                    <h4 class="mt-3">Your wishlist is empty</h4>
                    <p class="text-muted">Save items you love and find them here anytime.</p>
                    <a href="/" class="btn btn-outline-primary-2 mt-2"><span>Continue Shopping</span></a>
                </div>
            }
            else
            {
                <table class="table table-wishlist table-mobile">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Stock Status</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody id="wishlistBody">
                        @foreach (var item in Model)
                        {
                            var product = item.Product;
                            var imagePath = product?.PrimaryImagePath ?? "~/Website/assets/images/products/table/product-1.jpg";
                            var inStock = product?.IsAnyColorInStock ?? false;

                            <tr id="wishlistRow-@item.WishlistId">
                                <td class="product-col">
                                    <div class="product">
                                        <figure class="product-media">
                                            <a href="@Url.Action("detailproduct", "Home", new { id = item.ProductId })">
                                                <img src="@Url.Content(imagePath)" alt="@product?.Name">
                                            </a>
                                        </figure>

                                        <h3 class="product-title">
                                            <a href="@Url.Action("detailproduct", "Home", new { id = item.ProductId })">@product?.Name</a>
                                        </h3><!-- End .product-title -->
                                    </div><!-- End .product -->
                                </td>
                                <td class="price-col">
                                    @if (product != null && product.HasDiscount)
                                    {
                                        <span>@product.FormattedDiscountedPrice</span>
                                        <del class="text-muted ms-1" style="font-size:13px;">@product.FormattedPrice</del>
                                    }
                                    else
                                    {
                                        <span>@product?.FormattedPrice</span>
                                    }
                                </td>
                                <td class="stock-col">
                                    @if (inStock)
                                    {
                                        <span class="in-stock">In stock</span>
                                    }
                                    else
                                    {
                                        <span class="out-of-stock">Out of stock</span>
                                    }
                                </td>
                                <td class="action-col">
                                    @if (inStock)
                                    {
                                        <a href="@Url.Action("detailproduct", "Home", new { id = item.ProductId })" class="btn btn-block btn-outline-primary-2">
                                            <i class="icon-cart-plus"></i>View Product
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-block btn-outline-primary-2 disabled">Out of Stock</button>
                                    }
                                </td>
                                <td class="remove-col">
                                    <button class="btn-remove" onclick="removeFromWishlist(@item.WishlistId)">
                                        <i class="icon-close"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- End .table table-wishlist -->

                <div class="wishlist-share">
                    <div class="social-icons social-icons-sm mb-2">
                        <label class="social-label">Share on:</label>
                        <a href="#" class="social-icon" title="Facebook" target="_blank"><i class="icon-facebook-f"></i></a>
                        <a href="#" class="social-icon" title="Twitter" target="_blank"><i class="icon-twitter"></i></a>
                        <a href="#" class="social-icon" title="Instagram" target="_blank"><i class="icon-instagram"></i></a>
                        <a href="#" class="social-icon" title="Youtube" target="_blank"><i class="icon-youtube"></i></a>
                        <a href="#" class="social-icon" title="Pinterest" target="_blank"><i class="icon-pinterest"></i></a>
                    </div><!-- End .soial-icons -->
                </div>

                <!-- End .wishlist-share -->
            }
        </div><!-- End .container -->
    </div><!-- End .page-content -->
</main><!-- End .main -->
@section Scripts {
    <script>
        function removeFromWishlist(wishlistId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Wishlist/Remove', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: new URLSearchParams({ wishlistId })
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    const row = document.getElementById('wishlistRow-' + wishlistId);
                    if (row) row.remove();

                    const badge = document.getElementById('wishlistCountBadge');
                    if (badge) badge.innerText = result.wishlistCount;

                    const body = document.getElementById('wishlistBody');
                    if (body && body.children.length === 0) {
                        location.reload();
                    }
                } else {
                    alert(result.message || 'Something went wrong.');
                }
            })
            .catch(() => alert('Server communication error.'));
        }
    </script>
}
