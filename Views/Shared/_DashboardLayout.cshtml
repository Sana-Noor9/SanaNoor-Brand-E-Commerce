                    @inject IHttpContextAccessor accessor
                    @{
                        var userImage = accessor.HttpContext?.Session.GetString("userImage");
                        var userName = accessor.HttpContext?.Session.GetString("name") ?? "User";
                    }

                    <li class="nav-item dropdown user-profile">
                        <a href="javascript:void(0)" class="nav-link dropdown-toggle nav-link-lg nav-link-user" id="navbarDropdown4" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            @if (!string.IsNullOrEmpty(userImage))
                            {
                                <img src="@Url.Content("~/users/" + userImage)" alt="User Image" class="user-img-radious-style rounded-circle" style="width:40px; height:40px;" />
                            }
                            else
                            {
                                <img src="~/AdminLTE/assets/img/user.png" alt="Default Image" class="user-img-radious-style rounded-circle" style="width:40px; height:40px;" />
                            }
                            <span class="d-sm-none d-lg-inline-block"></span>
                        </a>

                        <div class="dropdown-menu dropdown-menu-right pullDown">
                            <div class="dropdown-title">Hello @userName</div>
                            <a href="profile.html" class="dropdown-item has-icon">
                                <i class="far fa-user"></i> Profile
                            </a>
                            <a href="timeline.html" class="dropdown-item has-icon">
                                <i class="fas fa-bolt"></i> Activities
                            </a>
