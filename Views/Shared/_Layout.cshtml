@using Microsoft.Extensions.Localization
@using SanaNoor_Brand
@inject IStringLocalizer<SharedResource> Localizer
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Molla - Bootstrap eCommerce Template</title>
    <meta name="keywords" content="HTML5 Template">
    <meta name="description" content="Molla - Bootstrap eCommerce Template">
    <meta name="author" content="p-themes">

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="~/Website/assets/images/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/Website/assets/images/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/Website/assets/images/icons/favicon-16x16.png">
    <link rel="manifest" href="~/Website/assets/images/icons/site.html">
    <link rel="mask-icon" href="~/Website/assets/images/icons/safari-pinned-tab.svg" color="#666666">
    <link rel="shortcut icon" href="~/Website/assets/images/icons/favicon.ico">
    <meta name="apple-mobile-web-app-title" content="Molla">
    <meta name="application-name" content="Molla">
    <meta name="msapplication-TileColor" content="#cc9966">
    <meta name="msapplication-config" content="~/Website/assets/images/icons/browserconfig.xml">
    <meta name="theme-color" content="#ffffff">

    <!-- CSS Files -->
    <link rel="stylesheet" href="~/Website/assets/vendor/line-awesome/line-awesome/line-awesome/css/line-awesome.min.css">
    <link rel="stylesheet" href="~/Website/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/Website/assets/css/plugins/owl-carousel/owl.carousel.css">
    <link rel="stylesheet" href="~/Website/assets/css/plugins/magnific-popup/magnific-popup.css">
    <link rel="stylesheet" href="~/Website/assets/css/plugins/jquery.countdown.css">
    <link rel="stylesheet" href="~/Website/assets/css/style.css">
    <link rel="stylesheet" href="~/Website/assets/css/skins/skin-demo-6.css">
    <link rel="stylesheet" href="~/Website/assets/css/demos/demo-6.css">
</head>

<body>
    <div class="page-wrapper">
        <header class="header header-6">
            <div class="header-top">
                <div class="container">
                    <div class="header-left">
                        <ul class="top-menu top-link-menu d-none d-md-block">
                            <li>
                                <a href="#">Links</a>
                                <ul>
                                    <li><a href="tel:#"><i class="icon-phone"></i>Call: +0123 456 789</a></li>
                                </ul>
                            </li>
                        </ul><!-- End .top-menu -->
                    </div><!-- End .header-left -->

                    <div class="header-right">
                        <div class="social-icons social-icons-color">
                            <a href="#" class="social-icon social-facebook" title="Facebook" target="_blank"><i class="icon-facebook-f"></i></a>
                            <a href="#" class="social-icon social-twitter" title="Twitter" target="_blank"><i class="icon-twitter"></i></a>
                            <a href="#" class="social-icon social-pinterest" title="Instagram" target="_blank"><i class="icon-pinterest-p"></i></a>
                            <a href="#" class="social-icon social-instagram" title="Pinterest" target="_blank"><i class="icon-instagram"></i></a>
                        </div><!-- End .social-icons -->

                        <ul class="top-menu top-link-menu">
                            <li>
                                <a href="#">Links</a>
                                <ul>
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <li>
                                            <form asp-controller="Auth" asp-action="Logout" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link" style="border: none; background: none; padding: 0; color: inherit;">
                                                    <i class="icon-user"></i>Logout
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li><a asp-controller="Auth" asp-action="Register"><i class="icon-user"></i>Sign in / Sign up</a></li>
                                    }
                                </ul>
                            </li>
                        </ul>

                        <div class="header-dropdown">
                            <a href="#">USD</a>
                            <div class="header-menu">
                                <ul>
                                    <li><a href="#">Eur</a></li>
                                    <li><a href="#">Usd</a></li>
                                </ul>
                            </div><!-- End .header-menu -->
                        </div><!-- End .header-dropdown -->

                        <div class="header-dropdown">
                            <a href="#">@(System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "fr" ? "Fr" : System.Threading.Thread.CurrentThread.CurrentUICulture.Name == "es" ? "Es" : "Eng")</a>
                            <div class="header-menu">
                                <ul>
                                    <li><a href="@Url.Action("SetLanguage", "Language", new { culture = "en", returnUrl = Context.Request.Path + Context.Request.QueryString })">English</a></li>
                                    <li><a href="@Url.Action("SetLanguage", "Language", new { culture = "fr", returnUrl = Context.Request.Path + Context.Request.QueryString })">French</a></li>
                                    <li><a href="@Url.Action("SetLanguage", "Language", new { culture = "es", returnUrl = Context.Request.Path + Context.Request.QueryString })">Spanish</a></li>
                                </ul>
                            </div><!-- End .header-menu -->
                        </div><!-- End .header-dropdown -->
                    </div><!-- End .header-right -->
                </div>
            </div><!-- End .header-top -->

            <div class="header-middle">
                <div class="container">
                    <div class="header-left">
                        <div class="header-search header-search-extended header-search-visible d-none d-lg-block">
                            <a href="#" class="search-toggle" role="button"><i class="icon-search"></i></a>
                            <form action="#" method="get">
                                <div class="header-search-wrapper search-wrapper-wide">
                                    <label for="q" class="sr-only">Search</label>
                                    <button class="btn btn-primary" type="submit"><i class="icon-search"></i></button>
                                    <input type="search" class="form-control" name="q" id="q" placeholder="@Localizer["SearchPlaceholder"]" required>
                                </div><!-- End .header-search-wrapper -->
                            </form>
                        </div><!-- End .header-search -->
                    </div>

                    <div class="header-center">
                        <a href="@Url.Action("Index", "Home")" class="logo">
                            <img src="~/Website/assets/images/demos/demo-6/logo.png" alt="Molla Logo" width="82" height="20">
                        </a>
                    </div><!-- End .header-center -->

                    <div class="header-right">
                        @await Component.InvokeAsync("WishlistCount")
                        @await Component.InvokeAsync("CartSummary")
                    </div><!-- End .header-right -->
                </div><!-- End .container -->
            </div><!-- End .header-middle -->

            <div class="header-bottom sticky-header">
                <div class="container">
                    <div class="header-left">
                        <nav class="main-nav">
                            <ul class="menu sf-arrows">
                                <li class="@((ViewData["CurrentAction"] as string == "Allproduct" && ViewData["CurrentController"] as string == "Home") ? "active" : "")">
                                    <a href="@Url.Action("Allproduct", "Home")">@Localizer["NavShop"]</a>
                                    <div class="megamenu megamenu-md">
                                        <div class="row no-gutters">
                                            <div class="col-md-8">
                                                <div class="menu-col">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="menu-title">Shop Layouts</div>
                                                            <ul>
                                                                <li><a href="#">Shop List</a></li>
                                                                <li><a href="#">Shop Grid 2 Columns</a></li>
                                                            </ul>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="menu-title">Shop Pages</div>
                                                            <ul>
                                                                <li class="@((ViewData["CurrentAction"] as string == "Cart" && ViewData["CurrentController"] as string == "Home") ? "active" : "")">
                                                                    <a href="@Url.Action("Index", "Cart")">Cart</a>
                                                                </li>
                                                                <li><a href="#">@Localizer["MyWishlist"]</a></li>
                                                                <li><a href="#">@Localizer["FooterMyAccount"]</a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="banner banner-overlay">
                                                    <a href="#" class="banner banner-menu">
                                                        <img src="~/Website/assets/images/menu/banner-1.jpg" alt="Banner">
                                                        <div class="banner-content banner-content-top">
                                                            <div class="banner-title text-white">Last <br>Chance<br><span><strong>Sale</strong></span></div>
                                                        </div>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>

                                <li class="@((ViewData["CurrentAction"] as string == "Productdetails" && ViewData["CurrentController"] as string == "Home") ? "active" : "")">
                                    <a href="@Url.Action("Productdetails", "Product")">@Localizer["NavProduct"]</a>
                                </li>
                                <li class="@((ViewData["CurrentAction"] as string == "About" && ViewData["CurrentController"] as string == "Home") ? "active" : "")">
                                    <a href="@Url.Action("About", "Home")">@Localizer["NavAbout"]</a>
                                </li>
                                <li class="@((ViewData["CurrentAction"] as string == "Contact" && ViewData["CurrentController"] as string == "Home") ? "active" : "")">
                                    <a href="@Url.Action("Contact", "Home")">@Localizer["NavContact"]</a>
                                </li>
                                <li class="@((ViewData["CurrentAction"] as string == "FAQs" && ViewData["CurrentController"] as string == "Home") ? "active" : "")">
                                    <a href="@Url.Action("FAQs", "Home")">@Localizer["NavFaqs"]</a>
                                </li>
                                <li class="@((ViewData["CurrentAction"] as string == "Blog" && ViewData["CurrentController"] as string == "Home") ? "active" : "")">
                                    <a href="@Url.Action("Blog", "Home")">@Localizer["NavBlog"]</a>
                                </li>
                            </ul><!-- End .menu -->
                        </nav><!-- End .main-nav -->

                        <button class="mobile-menu-toggler">
                            <span class="sr-only">Toggle mobile menu</span>
                            <i class="icon-bars"></i>
                        </button>
                    </div><!-- End .header-left -->

                    <div class="header-right">
                        <i class="la la-lightbulb-o"></i><p><span>@Localizer["ClearanceBanner"]</span></p>
                    </div>
                </div><!-- End .container -->
            </div><!-- End .header-bottom -->
        </header><!-- End .header -->

        <main class="main">
            @RenderBody()
        </main>

        <footer class="footer">
            <div class="footer-middle">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-6 col-lg-3">
                            <div class="widget widget-about">
                                <h4 class="widget-title">about molla</h4>
                                <p>Praesent dapibus, neque id cursus ucibus, tortor neque egestas augue, eu vulputate magna eros eu erat.</p>
                                <div class="social-icons">
                                    <a href="#" class="social-icon" title="Facebook" target="_blank"><i class="icon-facebook-f"></i></a>
                                    <a href="#" class="social-icon" title="Twitter" target="_blank"><i class="icon-twitter"></i></a>
                                    <a href="#" class="social-icon" title="Instagram" target="_blank"><i class="icon-instagram"></i></a>
                                    <a href="#" class="social-icon" title="Youtube" target="_blank"><i class="icon-youtube"></i></a>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3">
                            <div class="widget">
                                <h4 class="widget-title">Useful Links</h4>
                                <ul class="widget-list">
                                    <li><a href="@Url.Action("About", "Home")">About Molla</a></li>
                                    <li><a href="@Url.Action("FAQs", "Home")">FAQ</a></li>
                                    <li><a href="@Url.Action("Contact", "Home")">Contact us</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3">
                            <div class="widget">
                                <h4 class="widget-title">Customer Service</h4>
                                <ul class="widget-list">
                                    <li><a href="#">Payment Methods</a></li>
                                    <li><a href="#">Returns</a></li>
                                    <li><a href="#">Shipping</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-3">
                            <div class="widget">
                                <h4 class="widget-title">My Account</h4>
                                <ul class="widget-list">
                                    <li><a asp-controller="Auth" asp-action="Register">Sign In</a></li>
                                    <li><a asp-controller="Cart" asp-action="Index">View Cart</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="container">
                    <figure class="footer-payments">
                        <img src="~/Website/assets/images/payments.png" alt="Payment methods" width="272" height="20">
                    </figure>
                    <img src="~/Website/assets/images/demos/demo-6/logo-footer.png" alt="Molla Logo" width="82" height="25">
                    <p class="footer-copyright">Copyright © @DateTime.Now.Year Molla Store. All Rights Reserved.</p>
                </div>
            </div>
        </footer>
    </div>

    <button id="scroll-top" title="Back to Top"><i class="icon-arrow-up"></i></button>

    <!-- Mobile Menu Container -->
    <div class="mobile-menu-overlay"></div>
    <div class="mobile-menu-container">
        <div class="mobile-menu-wrapper">
            <span class="mobile-menu-close"><i class="icon-close"></i></span>

            <form action="#" method="get" class="mobile-search">
                <label for="mobile-search" class="sr-only">Search</label>
                <input type="search" class="form-control" name="mobile-search" id="mobile-search" placeholder="Search in..." required>
                <button class="btn btn-primary" type="submit"><i class="icon-search"></i></button>
            </form>

            <nav class="mobile-nav">
                <ul class="mobile-menu">
                    <li class="active">
                        <a href="@Url.Action("Index", "Home")">Home</a>
                    </li>
                    <li>
                        <a href="@Url.Action("Allproduct", "Home")">Shop</a>
                    </li>
                    <li>
                        <a href="@Url.Action("About", "Home")">About</a>
                    </li>
                    <li>
                        <a href="@Url.Action("Contact", "Home")">Contact</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- JS Scripts -->
    <script src="~/Website/assets/js/jquery.min.js"></script>
    <script src="~/Website/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/Website/assets/js/jquery.hoverIntent.min.js"></script>
    <script src="~/Website/assets/js/jquery.waypoints.min.js"></script>
    <script src="~/Website/assets/js/superfish.min.js"></script>
    <script src="~/Website/assets/js/owl.carousel.min.js"></script>
    <script src="~/Website/assets/js/bootstrap-input-spinner.js"></script>
    <script src="~/Website/assets/js/jquery.plugin.min.js"></script>
    <script src="~/Website/assets/js/jquery.magnific-popup.min.js"></script>
    <script src="~/Website/assets/js/jquery.countdown.min.js"></script>
    <script src="~/Website/assets/js/main.js"></script>
    <script src="~/Website/assets/js/demos/demo-6.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>